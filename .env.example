# Copy this file to .env and fill in the values you need.
# Nothing here is required just to browse the app - only to pin real files to
# IPFS, use WalletConnect, or deploy/verify contracts from the CLI.

# --- Frontend (Vite) ---------------------------------------------------
# WalletConnect / Reown project id (free): https://cloud.reown.com
# Without this, MetaMask and Coinbase Wallet (browser extensions) still work -
# only the WalletConnect QR-code option is hidden.
VITE_WALLETCONNECT_PROJECT_ID=

# --- Server (IPFS pinning via Pinata) -----------------------------------
# Create a JWT at https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
PINATA_GATEWAY=gateway.pinata.cloud

# --- Hardhat (only needed for `npx hardhat` CLI commands) ---------------
# RPC URLs: Alchemy (https://alchemy.com) or Infura (https://infura.io) both
# have free tiers that work fine for testnets.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_PRIVATE_KEY=
BASE_RPC_URL=
BASE_PRIVATE_KEY=
MAINNET_RPC_URL=
MAINNET_PRIVATE_KEY=

# Etherscan/Basescan API key, used by `npx hardhat verify` to publish source
# so buyers can read the contract on the block explorer.
ETHERSCAN_API_KEY=
